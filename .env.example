# 이 파일을 .env로 복사하고 실제 키는 로컬에서만 입력한다.
A6_API_KEY=replace-with-local-key
A6_API_BASE=https://api.a6api.com/v1
A6_MODEL=claude-sonnet-5

# A6 개인 스마트 라우터에서 판매자 ID 1263을 우선 경로로 설정한다.
# 이 값은 결과 메타데이터용이며 API에 판매자 선택값으로 전송하지 않는다.
A6_VENDOR_ID=1263

# 2026-07-30 A6 마켓 화면에서 확인한 판매자 ID 1263 가격.
A6_INPUT_USD_PER_M=0.0180
A6_OUTPUT_USD_PER_M=0.0900
A6_RUN_BUDGET_USD=1.0
# 웹 요청 전 이 금액을 남겨 두어 실제 호출이 월간 한도를 넘지 않게 한다.
A6_REQUEST_RESERVE_USD=0.01
# 일시적 네트워크·5xx는 이 제한 안에서 한 번만 재시도한다.
A6_REQUEST_TIMEOUT_SECONDS=60

# 공개 AMI 영어 샘플과 직접 녹음 한국어 샘플을 모두 처리한다.
WHISPER_LANGUAGE=auto
MIN_AUDIO_FILES=2
MAX_AUDIO_DURATION_SECONDS=120
# 0이면 로컬 개발에서는 인스턴스 분석 횟수를 제한하지 않는다.
MAX_ANALYSES_PER_INSTANCE=0

# 로컬 Docker volume은 persistent, Cloud Run 임시 파일시스템은 ephemeral이다.
BUDGET_PERSISTENCE=persistent
